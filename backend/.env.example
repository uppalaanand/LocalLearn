# =============================================
# LocalLearn Backend - Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/locallearn

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET=your_access_token_secret_here_change_me
JWT_REFRESH_SECRET=your_refresh_token_secret_here_change_me
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email (optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloudinary (optional - for image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
